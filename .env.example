# No cloud or analytics configuration is needed for guest editing and exports.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Server only. Use your Supabase session-pooler URL and trusted TLS.
DATABASE_URL=
# Optional trusted PEM certificate from the project Connect panel.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Browser-safe values only. Never add database passwords or elevated keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GITHUB_AUTH_ENABLED=false
VITE_EMAIL_SIGNUP_ENABLED=true
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
